{
  "_comment": "Paste the 'PreToolUse' and 'PostToolUse' sections into your ~/.claude/settings.json (under the 'hooks' object). CHANGE the paths to your repo location. Keep the API key in the 'env' block of the same file or in an environment variable — NOT hard-coded here in the repo.",

  "env": {
    "OPENROUTER_API_KEY": "",
    "OPENROUTER_MODEL": "anthropic/claude-haiku-4.5"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "'/ABSOLUTNA/SCIEZKA/prompt-injection-screen/.venv/bin/python' '/ABSOLUTNA/SCIEZKA/prompt-injection-screen/hooks/screen-hook.py'",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "'/ABSOLUTNA/SCIEZKA/prompt-injection-screen/.venv/bin/python' '/ABSOLUTNA/SCIEZKA/prompt-injection-screen/hooks/screen-hook.py'",
            "timeout": 50
          }
        ]
      }
    ]
  }
}
